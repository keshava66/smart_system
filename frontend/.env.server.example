# Settings for scripts/frontend.sh. Copy to .env.server and adjust.
# .env.server is not committed.

# Port users open in the browser. Must match the redirect URI registered in Azure.
PORT=8080

# Full path to node. Cron runs with a short PATH, so set it explicitly (`which node`).
NODE_BIN=/usr/bin/node

# HTTPS. Leave both empty to serve plain HTTP.
TLS_CERT=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_cert.pem
TLS_KEY=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_key.pem

# Optional. Defaults shown.
# HOST=0.0.0.0
# WORKERS=2
# LOG_MAX_MB=50
# LOG_KEEP=5
# ACCESS_LOG=1
