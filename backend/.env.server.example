# Settings for scripts/backend.sh. Copy to .env.server and adjust.
# .env.server is not committed. App settings stay in .env as before.

# Port the frontend calls (VITE_API_BASE_URL).
PORT=8000

# The virtualenv's python (cron runs with a short PATH, so give the full path).
PYTHON_BIN=/home/sa-prd-rdi-react-dev/Smarthub/backend/venv/bin/python

# HTTPS. Leave both empty to serve plain HTTP.
TLS_CERT=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_cert.pem
TLS_KEY=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_key.pem

# Optional. Defaults shown.
# HOST=0.0.0.0
# START_TIMEOUT=180      seconds the app may take to load before start gives up
# GRACEFUL_TIMEOUT=30    seconds in-flight requests get on stop
# LOG_MAX_MB=50
# LOG_KEEP=5
# ACCESS_LOG=1
